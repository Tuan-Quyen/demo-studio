+def local_offsets(video, clip, times, entries, epoch0, pill, budget_s):
+    """Per-frame alignment offsets (ms). Screencast pts drift against the page clock during a recording (backpressure),
+    so one global offset can leave stretches 40-90 ms off. For every frame score each candidate offset by whether an entry
+    within +-12 ms of the shifted time is STRICT; each frame takes the offset that wins over its +-LOCAL_HALF neighbours
+    (ties -> the smallest shift). A leak frame has no strict entry at any offset, so this cannot hide one."""
+    sel = [e for e in entries if e["rects"] and e.get("state", "masked") == "masked"]
+    ts = [e["t"] for e in sel]
+    cands = list(range(-LOCAL_RANGE_MS, LOCAL_RANGE_MS + 1, LOCAL_STEP_MS))
+    scores = []
+    for i, fr in iter_frames(video, clip["w"], clip["h"], budget_s):
+        row = []
+        for d in cands:
+            te = epoch0 + d + times[i] * 1000.0
+            lo, hi = bisect.bisect_left(ts, te - 12), bisect.bisect_right(ts, te + 12)
+            row.append(1 if any(_entry_ok(fr, e, pill) for e in sel[lo:hi]) else 0)
+        scores.append(row)
+    out = []
+    for i in range(len(scores)):
+        w = scores[max(0, i - LOCAL_HALF):i + LOCAL_HALF + 1]
+        tot = [sum(r[k] for r in w) for k in range(len(cands))]
+        best = max(tot)
+        out.append(0.0 if best == 0 else float(min((d for d, v in zip(cands, tot) if v == best), key=abs)))
+    return out
